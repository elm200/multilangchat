# .env にコピーして使う(.env は git 管理外)。

# 必須。https://openrouter.ai/settings/keys で発行。使用上限(credit limit)の設定を強く推奨(NOTES.md参照)。
OPENROUTER_API_KEY=

# 任意。未設定なら google/gemini-2.5-flash-lite を使う。
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# 任意。設定すると入室時に合言葉を要求する。
# USER_PASSPHRASE=

# 任意。1にすると、学習に使いうる配信先へのルーティングも許可する(無料モデルの多くはこれが必要。NOTES.md参照)。
# OPENROUTER_ALLOW_TRAINING=1
